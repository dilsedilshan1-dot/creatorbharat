# ═══════════════════════════════════════════════════════════
# CreatorBharat SaaS Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit your real .env file to version control.
# ═══════════════════════════════════════════════════════════

# ─── Database (PostgreSQL via Neon / Supabase / Railway) ─────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate strong secrets: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET="replace-with-64-char-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-64-char-random-secret"

# ─── Application ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development                        # development | production | test
FRONTEND_URL="http://localhost:5173"        # Public frontend URL (for redirects, CORS, emails)

# ─── CORS (Production Only) ───────────────────────────────────────────────────
# In production, set NODE_ENV=production and list all allowed origins here.
# Comma-separated list. Requests from any other origin will be rejected.
ALLOWED_ORIGINS="https://creatorbharat.com,https://admin.creatorbharat.com"

# ─── Razorpay Payments ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── Cloudinary (Image & File Uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="hello@creatorbharat.com"

# ─── SMS (Fast2SMS or Twilio) ─────────────────────────────────────────────────
FAST2SMS_API_KEY="your_fast2sms_api_key"
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE="+1234567890"

# ─── AI Models ────────────────────────────────────────────────────────────────
GEMINI_API_KEY="AIzaSy_your_gemini_api_key"
# ANTHROPIC_API_KEY="sk-ant-your_anthropic_key"  # Optional Claude fallback

# ─── Google OAuth (Optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://api.creatorbharat.com/api/auth/google/callback"

# ─── Admin Seed ───────────────────────────────────────────────────────────────
# Used only during initial DB seeding via the seeder block in index.js
ADMIN_EMAIL="admin@creatorbharat.com"
ADMIN_PASSWORD="Change-This-Strong-Password-2026!"

# ─── Onboarding Email Drip Cron ────────────────────────────────────────────────
# Set to true to disable the auto background cron interval (e.g. during local dev)
DISABLE_DRIP_CRON=false

# ─── Sentry Error Tracking (Optional but Recommended) ────────────────────────
# Create a project at https://sentry.io and paste your Backend Node.js DSN here
SENTRY_DSN=""
