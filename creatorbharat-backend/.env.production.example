# ═══════════════════════════════════════════════════════════════
# CreatorBharat Backend — Production Environment Variables
# ───────────────────────────────────────────────────────────────
# COPY THIS FILE: cp .env.production.example .env
# Then fill in all values marked with <REPLACE_ME>
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
# Supabase / Neon PostgreSQL production connection string
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require&connect_timeout=60&connection_limit=10"

# ── JWT Secrets (use strong random strings, 64+ chars) ───────
JWT_SECRET="<REPLACE_ME_STRONG_RANDOM_64_CHARS>"
JWT_REFRESH_SECRET="<REPLACE_ME_STRONG_RANDOM_64_CHARS_V2>"

# ── App Config ───────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL="https://creatorbharat.com"

# ── Razorpay (LIVE keys — NOT test keys!) ────────────────────
RAZORPAY_KEY_ID="rzp_live_<REPLACE_ME>"
RAZORPAY_SECRET="<REPLACE_ME>"
RAZORPAY_WEBHOOK_SECRET="<REPLACE_ME_WEBHOOK_SECRET>"

# ── Cloudinary (Media Storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME="<REPLACE_ME>"
CLOUDINARY_API_KEY="<REPLACE_ME>"
CLOUDINARY_API_SECRET="<REPLACE_ME>"

# ── Email — Resend ───────────────────────────────────────────
RESEND_API_KEY="re_<REPLACE_ME>"
EMAIL_FROM="hello@creatorbharat.com"

# ── AI Keys (Optional) ───────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-<REPLACE_ME>"
GEMINI_API_KEY="<REPLACE_ME>"

# ── Admin Panel Credentials ──────────────────────────────────
ADMIN_EMAIL="admin@creatorbharat.com"
ADMIN_PASSWORD="<REPLACE_ME_VERY_STRONG_PASSWORD>"
